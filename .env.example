# Observer environment configuration — copy to `.env` and edit.
# All values are optional unless noted. See README.md "Configuration" for details.

# Session signing key. REQUIRED in production: without it, the server picks a
# random secret on every start and silently invalidates all logged-in sessions
# at restart. Generate with: openssl rand -base64 48
JWT_SECRET=

# FastAPI listen port.
PORT=3001

# SQLAlchemy async URL. Default is a SQLite file in ./data/.
#   SQLite:    sqlite+aiosqlite:///./data/observer.db
#   Postgres:  postgresql+asyncpg://user:pass@host:5432/observer
#   MySQL:     mysql+asyncmy://user:pass@host:3306/observer
DATABASE_URL=sqlite+aiosqlite:///./data/observer.db

# Probe scheduler tick (seconds). Lower = more responsive, higher = less load.
RUNNER_TICK_SECONDS=5

# How often the heartbeat-retention pruner runs (seconds).
HEARTBEAT_PRUNE_INTERVAL_SECONDS=3600

# Default monitor interval, applied when a monitor has none.
DEFAULT_INTERVAL_SECONDS=30

# One-shot legacy upgrade: force-apply DEFAULT_INTERVAL_SECONDS to monitors
# with bad intervals at startup. Leave `false` after first run.
APPLY_DEFAULT_INTERVAL_ON_STARTUP=false

# 2FA TOTP issuer label shown in authenticator apps.
TWO_FA_ISSUER=Observer

# Optional LDAP bind defaults — UI form values override these at runtime.
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
